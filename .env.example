# Copy this file to ".env" and fill in YOUR values. Never upload .env to GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=uniresolve
DB_USER=your_db_user
DB_PASS=your_db_password
# Any long random text. Needed only to run seed.php in a browser. Delete seed.php after use.
SEED_TOKEN=change-me-to-something-long-and-random
